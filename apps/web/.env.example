# Use the final GitHub repository path when it is known, for example: /hvac-voice-ai-demo/
VITE_BASE_PATH=/

# Set this to the final trusted public site URL when deployment is added.
VITE_PUBLIC_ORIGIN=

# Set this to the deployed Worker origin during final setup, for example:
# https://hvac-demo-api.example.workers.dev
VITE_DEMO_API_URL=

# Optional public display-name override. This is not a secret.
VITE_DEMO_COMPANY_NAME=Austin Comfort HVAC

# Add the public Turnstile site key only when Cloudflare setup is performed.
VITE_TURNSTILE_SITE_KEY=
